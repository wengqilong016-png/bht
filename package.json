{
  "name": "bahati-jackpots",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "jest --no-coverage --passWithNoTests",
    "test:ci": "jest --no-coverage",
    "test:unit": "jest --no-coverage --testPathPatterns='__tests__/(?!integration/)' --passWithNoTests",
    "test:integration": "jest --no-coverage --testPathPatterns='__tests__/integration/' --passWithNoTests",
    "test:selfcheck:machine": "jest --no-coverage machineWorkflowSelfCheck",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:coverage:ci": "jest --coverage",
    "test:watch": "jest --watch --passWithNoTests",
    "test:e2e": "npx playwright test",
    "test:e2e:local-supabase": "npx playwright test e2e/driver-collection-flow.local-supabase.spec.ts",
    "test:e2e:ui": "npx playwright test --ui",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "node scripts/prune-android-web-assets.cjs && npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build:android": "npm run build && node scripts/prune-android-web-assets.cjs && npx cap sync android && cd android && ./gradlew assembleDebug",
    "cap:build:android:release": "npm run build && node scripts/prune-android-web-assets.cjs && npx cap sync android && cd android && ./gradlew assembleRelease",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@capacitor/geolocation": "^8.2.2",
    "@sentry/react": "^10.72.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "@types/leaflet": "^1.9.22",
    "@vercel/analytics": "^2.0.1",
    "exif-js": "^2.3.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "openai": "^6.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^30.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "postcss": "^8.5.15",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.10"
  }
}
